# Leave empty for same-origin API requests (Vite proxies /api, /auth and /static in development).
# Set to the deployed backend origin when frontend and backend are hosted separately.
VITE_API_URL=

# Firebase web app configuration used by Firebase Authentication, including Google sign-in.
# These client configuration values are not server-side secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
