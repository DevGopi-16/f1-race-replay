/* ============================================================
   F1 RACE REPLAY — PAGE STYLES
   Clean rewrite. Single source of truth per section —
   no duplicate blocks, no !important overrides.
   ============================================================ */

.replay-page {
  --replay-border: var(--color-white-08);
  --replay-muted: var(--color-white-45);
  --replay-panel: rgba(255, 255, 255, 0.035);

  position: relative;
  width: 100%;
  padding-bottom: var(--space-24);
}

/* ------------------------------------------------------------
   INTRO / HERO HEADER
   ------------------------------------------------------------ */

.replay-intro {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-12);

  width: 100%;
  padding: var(--space-8) 0 var(--space-10);

  border-bottom: var(--border-subtle);
}

.replay-intro-copy {
  min-width: 0;
}

.replay-intro-eyebrow {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-5);

  color: var(--replay-muted);
  font-family: var(--font-body);
  font-size: var(--text-caption);
  font-weight: var(--weight-bold);
  letter-spacing: var(--tracking-wider);
  text-transform: uppercase;
}

.replay-intro-eyebrow span:first-child {
  width: 28px;
  height: 1px;
  background: var(--color-accent);
  box-shadow: 0 0 10px var(--color-accent-glow);
}

.replay-intro h1 {
  margin: 0;
  color: var(--color-white);
  font-family: var(--font-display);
  font-size: clamp(2.75rem, 5.5vw, 5.5rem);
  font-weight: var(--weight-extrabold);
  line-height: 0.9;
  letter-spacing: var(--tracking-tight);
  text-transform: uppercase;
}

.replay-intro h1 span {
  color: var(--replay-muted);
}

.replay-intro p {
  max-width: 520px;
  margin: var(--space-5) 0 0;
  color: var(--replay-muted);
  font-size: var(--text-body-sm);
  line-height: 1.6;
}

.replay-intro-mark {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;

  padding-bottom: var(--space-1);
  color: var(--replay-muted);
  text-align: right;
}

.replay-intro-mark span {
  font-size: var(--text-micro);
  font-weight: var(--weight-bold);
  letter-spacing: var(--tracking-widest);
}

.replay-intro-mark strong {
  margin-top: var(--space-1);
  color: var(--color-accent);
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: var(--weight-black);
  letter-spacing: var(--tracking-tight);
}

@media (max-width: 700px) {
  .replay-intro {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
    padding: var(--space-5) 0 var(--space-6);
  }

  .replay-intro-mark {
    align-items: flex-start;
  }
}

/* ------------------------------------------------------------
   SELECTOR (year / round / session / fps)
   ------------------------------------------------------------ */

.replay-selector {
  display: grid;
  grid-template-columns: repeat(4, minmax(110px, 1fr));
  gap: var(--space-3);
  padding: var(--space-5) 0;
}

.replay-selector label {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.replay-selector label span {
  font-size: var(--text-micro);
  letter-spacing: var(--tracking-wider);
  text-transform: uppercase;
  color: var(--replay-muted);
}

.replay-selector select,
.replay-selector input {
  width: 100%;
  min-height: 42px;
  padding: 0 var(--space-3);

  border: var(--border-subtle);
  border-radius: var(--radius-sm);
  outline: none;

  background: var(--color-white-05);
  color: var(--color-white);
  font-size: var(--text-body-sm);

  transition: var(--transition-fast);
}

.replay-selector select:hover,
.replay-selector input:hover {
  border-color: var(--color-white-15);
}

.replay-selector select:focus,
.replay-selector input:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px var(--color-accent-soft);
}

@media (max-width: 700px) {
  .replay-selector {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* ------------------------------------------------------------
   STATUS (loading / error)
   ------------------------------------------------------------ */

.replay-status {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-top: var(--space-6);
  padding: var(--space-5);

  border: var(--border-subtle);
  border-radius: var(--radius-md);
  background: var(--replay-panel);
}

.replay-status-dot {
  width: 8px;
  height: 8px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: currentColor;
}

.replay-status-loading {
  color: var(--color-info);
}

.replay-status-error {
  color: var(--color-danger);
}

.replay-status strong {
  display: block;
  font-size: var(--text-caption);
  letter-spacing: var(--tracking-wide);
  color: var(--color-white);
}

.replay-status p {
  margin: var(--space-1) 0 0;
  color: var(--replay-muted);
  font-size: var(--text-body-sm);
}

/* ------------------------------------------------------------
   RACE INFO BAR (ReplayHero — year/round/title/lap)
   ------------------------------------------------------------ */

.session-info-overlay {
  width: 100%;
  margin-top: var(--space-6);
}

.replay-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  gap: var(--space-8);

  width: 100%;
  padding: var(--space-6) 0;

  border-bottom: var(--border-subtle);
}

.replay-hero-copy {
  min-width: 0;
}

.replay-kicker {
  display: block;
  font-size: var(--text-micro);
  letter-spacing: var(--tracking-wider);
  text-transform: uppercase;
  color: var(--replay-muted);
}

.replay-hero-copy h2 {
  margin: var(--space-2) 0 var(--space-1);
  color: var(--color-white);
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 2.8vw, 2.75rem);
  font-weight: var(--weight-bold);
  line-height: 1;
  letter-spacing: var(--tracking-tight);

  overflow-wrap: anywhere;
}

.replay-hero-copy p {
  margin: 0;
  color: var(--replay-muted);
  font-size: var(--text-body-sm);
}

.replay-hero-stat {
  flex-shrink: 0;
  min-width: 130px;
  padding-left: var(--space-6);

  border-left: var(--border-subtle);
  text-align: right;
}

.replay-hero-stat > span {
  display: block;
  margin-bottom: var(--space-1);
  font-size: var(--text-micro);
  letter-spacing: var(--tracking-wider);
  color: var(--replay-muted);
}

.replay-lap-value {
  display: inline-flex;
  align-items: baseline;
  gap: var(--space-1);

  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: var(--weight-extrabold);
  line-height: 1;
  color: var(--color-white);
}

.replay-lap-total {
  font-size: 0.6em;
  color: var(--replay-muted);
  font-weight: var(--weight-medium);
}

.replay-lap-separator {
  color: var(--replay-muted);
  opacity: 0.6;
}

@media (max-width: 700px) {
  .replay-hero {
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .replay-hero-stat {
    padding-left: 0;
    padding-top: var(--space-4);
    border-left: 0;
    border-top: var(--border-subtle);
    text-align: left;
  }
}

/* ------------------------------------------------------------
   CONTROLS (play / timeline / fps)
   ------------------------------------------------------------ */

.replay-controls {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);

  margin-top: var(--space-5);
  padding: var(--space-4) var(--space-5);

  border: var(--border-subtle);
  border-radius: var(--radius-lg);
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
}

.replay-controls-row {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.replay-play-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;

  width: 42px;
  height: 42px;

  border: var(--border-subtle);
  border-radius: 50%;
  background: var(--color-white);
  color: var(--color-black);

  cursor: pointer;
  transition: var(--transition-fast);
}

.replay-play-button:hover:not(:disabled) {
  background: var(--color-white-90);
  transform: scale(1.05);
}

.replay-play-button:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

.replay-play-button svg {
  width: 14px;
  height: 14px;
}

.replay-frame-counter {
  font-family: var(--font-mono);
  font-size: var(--text-caption);
  letter-spacing: var(--tracking-wide);
  color: var(--replay-muted);
  white-space: nowrap;
}

.replay-frame-counter strong {
  color: var(--color-white);
  font-weight: var(--weight-bold);
}

.replay-fps {
  margin-left: auto;
  padding: var(--space-1) var(--space-3);

  border: var(--border-subtle);
  border-radius: var(--radius-pill);

  color: var(--replay-muted);
  font-size: var(--text-micro);
  font-weight: var(--weight-bold);
  letter-spacing: var(--tracking-wide);
  white-space: nowrap;
}

.replay-timeline {
  width: 100%;
  height: 4px;
  margin: 0;

  appearance: none;
  -webkit-appearance: none;
  cursor: pointer;

  border-radius: var(--radius-pill);
  background:
    linear-gradient(
      to right,
      var(--color-accent) 0%,
      var(--color-accent) var(--replay-progress, 0%),
      var(--color-white-08) var(--replay-progress, 0%),
      var(--color-white-08) 100%
    );
}

.replay-timeline:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.replay-timeline::-webkit-slider-thumb {
  appearance: none;
  -webkit-appearance: none;

  width: 14px;
  height: 14px;
  margin-top: -5px;

  border-radius: 50%;
  border: 2px solid var(--color-black);
  background: var(--color-white);

  box-shadow: 0 0 0 1px var(--color-white-30);
  transition: var(--transition-fast);
}

.replay-timeline::-webkit-slider-thumb:hover {
  transform: scale(1.15);
}

.replay-timeline::-moz-range-thumb {
  width: 14px;
  height: 14px;

  border-radius: 50%;
  border: 2px solid var(--color-black);
  background: var(--color-white);
  cursor: pointer;
}

.replay-timeline::-moz-range-track {
  height: 4px;
  border-radius: var(--radius-pill);
  background: var(--color-white-08);
}

.replay-timeline::-moz-range-progress {
  height: 4px;
  border-radius: var(--radius-pill);
  background: var(--color-accent);
}

@media (max-width: 600px) {
  .replay-controls-row {
    flex-wrap: wrap;
    row-gap: var(--space-2);
  }

  .replay-fps {
    order: 1;
    margin-left: 0;
  }
}

/* ============================================================
   REPLAY — FINAL CINEMATIC LAYOUT OVERRIDE
   This section intentionally comes LAST.
   ============================================================ */

/* ------------------------------------------------------------
   PAGE SHELL
   ------------------------------------------------------------ */

.page-container.replay-page {
  width: min(
    calc(100% - 80px),
    1800px
  ) !important;

  max-width: 1800px !important;

  margin-left: auto !important;
  margin-right: auto !important;

  padding-top: 132px !important;
  padding-bottom: 100px !important;

  box-sizing: border-box;
}


/* ------------------------------------------------------------
   INTRO
   ------------------------------------------------------------ */

.page-container.replay-page .replay-intro {
  display: grid !important;

  grid-template-columns:
    minmax(0, 1fr)
    220px !important;

  align-items: end !important;

  gap: 60px !important;

  width: 100% !important;

  padding:
    70px 0 44px !important;

  margin: 0 !important;

  border-bottom: 1px solid var(--color-white-08) !important;
}

.page-container.replay-page .replay-intro-copy {
  min-width: 0 !important;
}

.page-container.replay-page .replay-intro-eyebrow {
  display: flex !important;
  align-items: center !important;

  gap: 10px !important;

  margin-bottom: 24px !important;

  font-size: 0.62rem !important;
  letter-spacing: 0.2em !important;
}

.page-container.replay-page .replay-intro-eyebrow span:first-child {
  display: block !important;

  width: 34px !important;
  height: 1px !important;

  flex: 0 0 34px !important;

  background: var(--color-accent) !important;

  box-shadow:
    0 0 12px var(--color-accent-glow) !important;
}

.page-container.replay-page .replay-intro h1 {
  display: block !important;

  margin: 0 !important;

  max-width: 1050px !important;

  color: var(--color-white) !important;

  font-family: var(--font-display) !important;

  font-size: clamp(
    4.5rem,
    7vw,
    8.5rem
  ) !important;

  font-weight: var(--weight-extrabold) !important;

  line-height: 0.82 !important;

  letter-spacing: -0.075em !important;

  text-transform: uppercase !important;
}

.page-container.replay-page .replay-intro h1 span {
  color: var(--replay-muted) !important;
}

.page-container.replay-page .replay-intro p {
  max-width: 600px !important;

  margin: 28px 0 0 !important;

  color: var(--color-white-45) !important;

  font-family: var(--font-body) !important;

  font-size: 0.9rem !important;

  line-height: 1.6 !important;
}

.page-container.replay-page .replay-intro-mark {
  align-self: end !important;

  padding-bottom: 6px !important;

  text-align: right !important;
}

.page-container.replay-page .replay-intro-mark strong {
  font-size: 2.2rem !important;

  letter-spacing: -0.04em !important;
}


/* ------------------------------------------------------------
   SELECTOR
   ------------------------------------------------------------ */

.page-container.replay-page .replay-selector {
  display: grid !important;

  grid-template-columns:
    repeat(4, minmax(150px, 1fr)) !important;

  gap: 0 !important;

  width: 100% !important;

  margin: 0 !important;

  padding: 0 !important;

  border-bottom: 1px solid var(--color-white-08) !important;
}

.page-container.replay-page .replay-selector label {
  display: flex !important;

  flex-direction: column !important;

  gap: 8px !important;

  min-height: 76px !important;

  justify-content: center !important;

  padding: 0 24px !important;

  border-right: 1px solid var(--color-white-08) !important;

  box-sizing: border-box !important;
}

.page-container.replay-page .replay-selector label:first-child {
  padding-left: 0 !important;
}

.page-container.replay-page .replay-selector label:last-child {
  border-right: 0 !important;
}

.page-container.replay-page .replay-selector label > span {
  font-size: 0.55rem !important;

  font-weight: var(--weight-bold) !important;

  letter-spacing: 0.18em !important;

  color: var(--color-white-45) !important;
}

.page-container.replay-page .replay-selector select,
.page-container.replay-page .replay-selector input {
  width: 100% !important;

  padding: 0 !important;

  border: 0 !important;

  outline: 0 !important;

  background: transparent !important;

  color: var(--color-white) !important;

  font-family: var(--font-body) !important;

  font-size: 0.82rem !important;

  font-weight: 600 !important;
}


/* ------------------------------------------------------------
   SESSION INFORMATION
   ------------------------------------------------------------ */

.page-container.replay-page .session-info-overlay {
  position: relative !important;

  width: 100% !important;

  margin: 0 !important;

  padding: 42px 0 34px !important;

  box-sizing: border-box !important;
}

.page-container.replay-page .session-info-overlay .replay-hero {
  display: grid !important;

  grid-template-columns:
    minmax(0, 1fr)
    auto !important;

  align-items: end !important;

  width: 100% !important;

  gap: 40px !important;

  margin: 0 !important;

  padding: 0 !important;
}

.page-container.replay-page .replay-hero-copy {
  min-width: 0 !important;
}

.page-container.replay-page .replay-kicker {
  display: block !important;

  margin-bottom: 10px !important;

  font-size: 0.58rem !important;

  letter-spacing: 0.18em !important;

  color: var(--color-white-45) !important;
}

.page-container.replay-page .replay-hero-copy h2 {
  margin: 0 !important;

  font-family: var(--font-display) !important;

  font-size: clamp(
    2rem,
    3.4vw,
    3.6rem
  ) !important;

  font-weight: var(--weight-extrabold) !important;

  line-height: 0.9 !important;

  letter-spacing: -0.055em !important;

  text-transform: uppercase !important;
}

.page-container.replay-page .replay-hero-copy p {
  margin: 12px 0 0 !important;

  font-size: 0.8rem !important;

  color: var(--color-white-45) !important;
}

.page-container.replay-page .replay-hero-stat {
  min-width: 180px !important;

  padding-left: 30px !important;

  border-left: 1px solid var(--color-white-08) !important;

  text-align: right !important;
}

.page-container.replay-page .replay-hero-stat > span {
  display: block !important;

  margin-bottom: 7px !important;

  font-size: 0.55rem !important;

  letter-spacing: 0.18em !important;

  color: var(--color-white-45) !important;
}

.page-container.replay-page .replay-lap-value {
  display: inline-flex !important;

  align-items: baseline !important;

  gap: 6px !important;

  font-family: var(--font-display) !important;

  font-size: 2.8rem !important;

  font-weight: var(--weight-extrabold) !important;

  line-height: 0.9 !important;
}


/* ------------------------------------------------------------
   TRACK
   ------------------------------------------------------------ */

.page-container.replay-page .replay-track-panel {
  width: 100% !important;

  max-width: none !important;

  margin: 0 !important;
}

.page-container.replay-page .track-viewport {
  position: relative !important;

  width: 100% !important;

  height: min(
    720px,
    48vw
  ) !important;

  min-height: 560px !important;

  max-height: 760px !important;

  border-radius: 16px !important;

  overflow: hidden !important;
}


/* ------------------------------------------------------------
   CONTROLS
   ------------------------------------------------------------ */

.page-container.replay-page .replay-controls {
  width: 100% !important;

  margin-top: 22px !important;
}


/* ------------------------------------------------------------
   TABLET
   ------------------------------------------------------------ */

@media (max-width: 1100px) {

  .page-container.replay-page {
    width: min(
      calc(100% - 48px),
      1800px
    ) !important;
  }

  .page-container.replay-page .replay-intro {
    grid-template-columns: 1fr !important;

    gap: 30px !important;
  }

  .page-container.replay-page .replay-intro-mark {
    display: none !important;
  }

  .page-container.replay-page .track-viewport {
    height: 60vw !important;

    min-height: 500px !important;
  }
}


/* ------------------------------------------------------------
   MOBILE
   ------------------------------------------------------------ */

@media (max-width: 700px) {

  .page-container.replay-page {
    width: calc(100% - 28px) !important;

    padding-top: 105px !important;
  }

  .page-container.replay-page .replay-intro {
    display: block !important;

    padding:
      44px 0 30px !important;
  }

  .page-container.replay-page .replay-intro h1 {
    font-size: clamp(
      3.2rem,
      15vw,
      5rem
    ) !important;
  }

  .page-container.replay-page .replay-intro p {
    font-size: 0.78rem !important;
  }

  .page-container.replay-page .replay-selector {
    grid-template-columns:
      repeat(2, minmax(0, 1fr)) !important;
  }

  .page-container.replay-page .replay-selector label {
    min-height: 68px !important;

    padding: 0 14px !important;

    border-bottom:
      1px solid var(--color-white-08) !important;
  }

  .page-container.replay-page .replay-selector label:nth-child(2) {
    border-right: 0 !important;
  }

  .page-container.replay-page .session-info-overlay .replay-hero {
    grid-template-columns: 1fr !important;

    gap: 24px !important;
  }

  .page-container.replay-page .replay-hero-stat {
    padding-left: 0 !important;

    border-left: 0 !important;

    text-align: left !important;
  }

  .page-container.replay-page .track-viewport {
    height: 75vw !important;

    min-height: 340px !important;
  }
}

