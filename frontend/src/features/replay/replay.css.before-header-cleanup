
/* ============================================================
   REPLAY — PHASE 2H
   Cinematic replay experience
   ============================================================ */

.replay-page {
  --replay-border: rgba(255,255,255,.10);
  --replay-muted: rgba(255,255,255,.48);
  --replay-panel: rgba(255,255,255,.035);

  padding-bottom: 120px;
}

.replay-hero {
  position: relative;
  z-index: 1;

  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 32px;

  width: 100%;
  min-width: 0;

  margin-top: 32px;
  padding: 42px 0 30px;

  border-bottom: 1px solid var(--replay-border);
}



.replay-kicker,
.replay-track-header,
.replay-progress-meta,
.replay-selector label span {
  font-size: 10px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--replay-muted);
}

.replay-hero h2 {
  margin: 10px 0 6px;
  font-size: clamp(34px, 5vw, 72px);
  line-height: .95;
  letter-spacing: -.045em;
}

.replay-hero p {
  margin: 0;
  color: var(--replay-muted);
}

.replay-hero-stat {
  min-width: 160px;
  text-align: right;
}

.replay-hero-stat span {
  display: block;
  font-size: 10px;
  letter-spacing: .2em;
  color: var(--replay-muted);
}

.replay-hero-stat strong {
  display: block;
  margin-top: 5px;
  font-size: 52px;
  line-height: 1;
}

.replay-hero-stat small {
  font-size: 16px;
  color: var(--replay-muted);
}

.replay-selector {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(120px, 1fr));
  gap: 12px;
  padding: 18px 0;
}

.replay-selector label {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.replay-selector select,
.replay-selector input {
  width: 100%;
  min-height: 44px;
  padding: 0 13px;
  border: 1px solid var(--replay-border);
  border-radius: 10px;
  outline: none;
  background: rgba(255,255,255,.045);
  color: white;
}

.replay-status {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 28px;
  padding: 22px;
  border: 1px solid var(--replay-border);
  border-radius: 14px;
  background: var(--replay-panel);
}

.replay-status-dot {
  width: 8px;
  height: 8px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: currentColor;
}

.replay-status strong {
  font-size: 11px;
  letter-spacing: .16em;
}

.replay-status p {
  margin: 5px 0 0;
  color: var(--replay-muted);
  font-size: 13px;
}

.replay-track {
  margin-top: 28px;
  overflow: hidden;
  border: 1px solid var(--replay-border);
  border-radius: 18px;
  background:
    radial-gradient(
      circle at center,
      rgba(255,255,255,.055),
      transparent 55%
    ),
    rgba(255,255,255,.018);
}

.replay-track-header {
  display: flex;
  justify-content: space-between;
  padding: 15px 18px;
  border-bottom: 1px solid var(--replay-border);
}

.replay-track-canvas {
  position: relative;
  min-height: 560px;
  padding: 30px;
}

.replay-track-svg {
  width: 100%;
  height: 100%;
  min-height: 500px;
  overflow: visible;
}

.replay-track-glow,
.replay-track-line {
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.replay-track-glow {
  stroke: rgba(255,255,255,.12);
  stroke-width: 2.8;
  filter: blur(2px);
}

.replay-track-line {
  stroke: rgba(255,255,255,.65);
  stroke-width: 1;
}

.replay-car {
  filter: drop-shadow(
    0 0 5px currentColor
  );
}

.replay-track-empty {
  min-height: 320px;
  display: grid;
  place-items: center;
  color: var(--replay-muted);
  font-size: 10px;
  letter-spacing: .18em;
}

.replay-controls {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-top: 18px;
  padding: 15px 18px;
  border: 1px solid var(--replay-border);
  border-radius: 14px;
  background: rgba(255,255,255,.035);
}

.replay-play {
  min-width: 80px;
  min-height: 38px;
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 8px;
  background: white;
  color: black;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .14em;
  cursor: pointer;
}

.replay-progress {
  flex: 1;
}

.replay-progress-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 7px;
}

.replay-progress input {
  width: 100%;
  height: 3px;
  appearance: none;
  cursor: pointer;
}

.replay-speed {
  min-width: 55px;
  text-align: right;
  color: var(--replay-muted);
  font-size: 10px;
  letter-spacing: .1em;
}

@media (max-width: 760px) {
  .replay-hero {
    align-items: flex-start;
    flex-direction: column;
  }

  .replay-hero-stat {
    text-align: left;
  }

  .replay-selector {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .replay-track-canvas {
    min-height: 380px;
    padding: 15px;
  }

  .replay-track-svg {
    min-height: 350px;
  }

  .replay-controls {
    flex-wrap: wrap;
  }

  .replay-progress {
    order: 3;
    flex-basis: 100%;
  }
}

.replay-lap-value {
  display: inline-flex;
  align-items: baseline;
  gap: 7px;
}

.replay-lap-current {
  display: inline-block;
}

.replay-lap-total {
  display: inline-block;
  white-space: nowrap;
}

