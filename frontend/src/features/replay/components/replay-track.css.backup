.replay-track-panel {
  width: 100%;
  min-width: 0;
  margin-top: 20px;
}

.track-viewport {
  position: relative;

  width: 100%;
  height: clamp(500px, 70vh, 760px);

  min-height: 500px;

  overflow: hidden;

  border: 1px solid var(--replay-border);
  border-radius: 18px;

  background:
    radial-gradient(
      circle at center,
      rgba(255,255,255,.055),
      transparent 58%
    ),
    #07090d;

  isolation: isolate;
}

.replay-track-canvas {
  position: absolute;

  inset: 0;

  display: block;

  width: 100%;
  height: 100%;

  min-width: 0;
  min-height: 0;

  max-width: none;
  max-height: none;

  margin: 0;
  padding: 0;

  overflow: hidden;

  z-index: 1;
}

.track-overlay {
  position: absolute;

  top: 18px;
  left: 18px;

  z-index: 5;

  display: flex;
  align-items: center;

  gap: 10px;

  padding: 8px 11px;

  border: 1px solid
    rgba(255,255,255,.12);

  border-radius: 8px;

  background:
    rgba(5,7,11,.78);

  backdrop-filter: blur(12px);

  color: var(--replay-muted);

  font-size: 10px;
  font-weight: 700;

  letter-spacing: .16em;

  pointer-events: none;
}

.track-overlay strong {
  color: #ffffff;

  font-weight: 800;
}

.track-frame-info {
  position: absolute;

  right: 18px;
  bottom: 18px;

  z-index: 5;

  padding: 7px 10px;

  border-radius: 7px;

  background:
    rgba(5,7,11,.78);

  border: 1px solid
    rgba(255,255,255,.10);

  color: var(--replay-muted);

  font-size: 9px;

  font-weight: 700;

  letter-spacing: .14em;

  pointer-events: none;
}

.track-frame-info strong {
  color: #ffffff;
}

@media (max-width: 900px) {
  .track-viewport {
    height: 64vh;
    min-height: 430px;
  }
}

@media (max-width: 600px) {
  .track-viewport {
    height: 56vh;
    min-height: 350px;

    border-radius: 12px;
  }

  .track-overlay {
    top: 10px;
    left: 10px;

    padding: 7px 9px;

    font-size: 9px;
  }

  .track-frame-info {
    right: 10px;
    bottom: 10px;
  }
}
