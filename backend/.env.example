# Runtime mode. Production enables required-configuration validation.
ENV=development

# PostgreSQL connection. Railway may provide postgres://; it is normalized at startup.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/f1_replay

# Required for signing authentication and verification tokens.
JWT_SECRET=

# Cookie settings. Set AUTH_COOKIE_SECURE=false only for local HTTP development.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Frontend URL used in email links and as the default CORS/OAuth frontend origin.
FRONTEND_BASE_URL=http://localhost:5173

# Legacy frontend-origin fallback; prefer FRONTEND_BASE_URL and CORS_ORIGINS.
FRONTEND_ORIGIN=http://localhost:5173

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Resend email service and default sender. Use a sender verified with Resend in production.
RESEND_API_KEY=
EMAIL_FROM=F1 Race Replay <onboarding@resend.dev>

# Compatibility fallback for EMAIL_FROM; prefer EMAIL_FROM.
CONTACT_FROM_EMAIL=

# Destination for contact-form mail.
CONTACT_TO_EMAIL=f1racevision.contact@gmail.com

# FastF1 cache directory and generated application data.
FASTF1_CACHE_DIR=./.fastf1-cache
DATA_DIR=./data
COMPUTED_DATA_DIR=./computed_data

# Firebase Admin service-account credential as raw JSON or base64-encoded JSON.
# Prefer this for Railway; never commit a real credential.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional fallback file path, relative to the backend working directory.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Discord OAuth credentials and registered backend callback.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

# Frontend callback URLs used by Discord OAuth.
FRONTEND_DISCORD_CALLBACK=http://localhost:5173/auth/discord/callback
FRONTEND_PROFILE_URL=http://localhost:5173/profile

# X OAuth credentials and registered backend callback.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/auth/x/callback

# Frontend callback URL used by X OAuth.
FRONTEND_X_CALLBACK=http://localhost:5173/auth/x/callback

# Security audit log file; stdout logging is also enabled for Railway.
SECURITY_LOG_FILE=./logs/security_events.log
